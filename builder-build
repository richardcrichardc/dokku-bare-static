#!/usr/bin/env bash
source "$PLUGIN_CORE_AVAILABLE_PATH/common/functions"
source "$PLUGIN_CORE_AVAILABLE_PATH/common/property-functions"
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

trigger-bare-static-builder-build() {
  declare desc="bare-static builder-build plugin trigger"
  declare trigger="builder-build"
  declare BUILDER_TYPE="$1" APP="$2" SOURCECODE_WORK_DIR="$3"

  if [[ "$BUILDER_TYPE" != "bare-static" ]]; then
    return
  fi

  local PLUGIN_ROOT
  PLUGIN_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

  dokku_log_info1 "Building $APP as a bare-static site"

  if [[ ! -d "$SOURCECODE_WORK_DIR/public" ]]; then
    dokku_log_fail "No 'public/' directory found in repo root"
  fi

  local SERVE_ROOT="$DOKKU_LIB_ROOT/data/bare-static/$APP"
  mkdir -p "$SERVE_ROOT"

  local STAGE="$SERVE_ROOT/public.new"
  rm -rf "$STAGE"
  cp -R "$SOURCECODE_WORK_DIR/public" "$STAGE"
  rm -rf "$SERVE_ROOT/public"
  mv "$STAGE" "$SERVE_ROOT/public"

  local NGINX_APP_DIR="$DOKKU_LIB_ROOT/data/nginx-vhosts/app-$APP"
  mkdir -p "$NGINX_APP_DIR"
  cp "$PLUGIN_ROOT/templates/nginx.conf.sigil" "$NGINX_APP_DIR/nginx.conf.sigil"
  # core-post-extract drops a .missing sentinel (no image to pull a template
  # from) which makes nginx-vhosts bail out of custom-template lookup.
  rm -f "$NGINX_APP_DIR/nginx.conf.sigil.$DOKKU_PID.missing" \
        "$NGINX_APP_DIR/nginx.conf.sigil.$DOKKU_PID"

  # If the app was previously deployed under a non-null scheduler, stop
  # whatever it was running before we switch its scheduler to null.
  local CURRENT_SCHEDULER
  CURRENT_SCHEDULER="$(fn-plugin-property-get-default scheduler "$APP" selected "")"
  if [[ -z "$CURRENT_SCHEDULER" ]]; then
    CURRENT_SCHEDULER="$(fn-plugin-property-get-default scheduler --global selected docker-local)"
  fi
  if [[ "$CURRENT_SCHEDULER" != "null" ]]; then
    plugn trigger scheduler-stop "$CURRENT_SCHEDULER" "$APP"
  fi

  fn-plugin-property-write scheduler "$APP" selected null

  # Dokku's release phase verifies dokku/<app>:latest exists via
  # `docker image inspect` and hard-fails if missing. Stamp a trivial
  # placeholder image so the verify passes; scheduler=null guarantees
  # nothing is ever started from it.
  local IMAGE
  IMAGE="$(get_app_image_name "$APP")"
  "$DOCKER_BIN" image build -q -t "$IMAGE" - <<DOCKERFILE >/dev/null
FROM scratch
LABEL com.dokku.app-name=$APP
LABEL com.dokku.builder-type=bare-static
DOCKERFILE

  plugn trigger ports-set-detected "$APP" "http:80:80"

  # scheduler-null has no scheduler-deploy, so Dokku's normal core-post-deploy
  # (which fires nginx regen) never runs. Fire the proxy rebuild ourselves so
  # our template actually gets rendered into the live vhost.
  plugn trigger proxy-build-config "$APP"

  dokku_log_info1 "bare-static: $APP served from $SERVE_ROOT/public"
}

trigger-bare-static-builder-build "$@"
