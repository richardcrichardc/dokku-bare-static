#!/usr/bin/env bash
source "$PLUGIN_CORE_AVAILABLE_PATH/common/functions"
source "$PLUGIN_CORE_AVAILABLE_PATH/common/property-functions"
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

trigger-bare-static-post-delete() {
  declare desc="cleans up bare-static data for a deleted app"
  declare trigger="post-delete"
  declare APP="$1"

  local SERVE_ROOT="$DOKKU_LIB_ROOT/data/bare-static/$APP"
  if [[ -d "$SERVE_ROOT" ]]; then
    "$DOCKER_BIN" image rm -f "$(get_app_image_name "$APP")" &>/dev/null || true
  fi

  rm -rf "$SERVE_ROOT"
  fn-plugin-property-destroy "bare-static" "$APP"
}

trigger-bare-static-post-delete "$@"
